# 依赖
node_modules/

# pnpm 本地 store（沙盒环境绕过，不入仓）
.pnpm-store/
.pnpm/

# 本地 Node 工具链（沙盒无 Node 22，本地解压用，不入仓）
.tools/

# 构建产物
dist/
build/
*.tsbuildinfo

# 运行期数据（不入版本管理）
data/
logs/

# 运行期配置（用户本机修改，不入版本管理；提供 .example 模板）
config/app.json
config/boards/*.local.json
config/parts/*.local.json

# WASM 产物（AGENTS 硬约束/02-§5.3.1：经 Docker 构建后入库 apps/web/src/sim/mpy/，供 CI golden 引擎A 使用）
*.wasm
!apps/web/src/sim/mpy/micropython.wasm

# 环境变量
.env
.env.*
!.env.example

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 测试与覆盖率
coverage/
.playwright-report/
playwright-report/
test-results/

# SSH 密钥（git push 专用，不入版本管理）
.ssh/

# 临时日志（上一会话 skill 安装日志等）
skills-install.log
*.local.log

# 规划工作文档（已并入 documents/ 对应章节，原始文件不入仓）
findings.md
progress.md
task_plan.md
