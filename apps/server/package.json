{
  "name": "@esp32-sim/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^4.8.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/websocket": "^10.0.0",
    "@fastify/static": "^7.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.23.0",
    "execa": "^9.1.0",
    "pino": "^9.0.0",
    "pino-roll": "^2.0.0",
    "@esp32-sim/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "typescript": "^5.6.0",
    "ws": "^8.21.3"
  }
}
