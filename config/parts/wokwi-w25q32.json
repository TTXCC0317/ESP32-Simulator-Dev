{
  "type": "wokwi-w25q32",
  "name": "W25Q32 SPI Flash (32Mbit)",
  "category": "io",
  "defVersion": 1,
  "pins": [
    { "name": "VCC", "role": "power", "x": 8, "y": 8 },
    { "name": "GND", "role": "gnd", "x": 8, "y": 32 },
    { "name": "CS", "role": "spi.cs", "x": 8, "y": 56 },
    { "name": "SCK", "role": "spi.sck", "x": 8, "y": 80 },
    { "name": "MOSI", "role": "spi.mosi", "x": 8, "y": 104 },
    { "name": "MISO", "role": "spi.miso", "x": 8, "y": 128 }
